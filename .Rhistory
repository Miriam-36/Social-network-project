library(tidyverse)
library(igraph)
library(igraphdata)
library(jsonlite)
library(visNetwork)
library(widgetframe)
library(ggthemes)
library(readr)
raw <- read_delim(
file       = "brazilian_prostitution.csv",
delim      = ";",
comment    = "#",
col_names  = FALSE,
trim_ws    = TRUE,
col_types  = cols(.default = col_integer())
) |>
rename(
`Female-id`                                                                       = X1,
`Male-id`                                                                         = X2,
`Date (in days) of posting`                                                       = X3,
`Female grade given by the male`                  = X4,
`Anal sex with/without condom?`  = X5,
`Oral sex with condom?`          = X6,
`Mouth kiss?`                    = X7
) |>
select(-`Date (in days) of posting`)
raw
g <- graph_from_data_frame(raw, directed=FALSE) |> simplify()
vcount(g)
ecount(g)
degree(g) |>
mean()
set.seed(111)
links_deleted <- sample(1:ecount(g), 5000)
positive_class_links <- as.data.frame(ends(g, links_deleted))
# ends to get the nodes (Vs) that where connected by those edges.
positive_class_links
negative_class_links <- data.frame()
"g'" <- delete_edges(g, links_deleted)
most_connected <- which(degree(g) > 10)
while(nrow(negative_class_links) < 5000) {
pair <- sample(most_connected, 2)
# Check that no edge exists between them
if(are_adjacent(g, pair[1], pair[2]) == FALSE) {
negative_class_links <- rbind(negative_class_links, data.frame(V1 = pair[1], V2 = pair[2]))
}
}
true_edges <- data.frame(positive_class_links)
false_edges <- data.frame(negative_class_links)
intersect(as.numeric(positive_class_links), as.numeric(negative_class_links))
total_edges <- rbind(true_edges,false_edges)
colnames(total_edges) <- c("id1","id2","obs")
true_edges <- data.frame(positive_class_links, obs = 1)
false_edges <- data.frame(negative_class_links, obs = 0)
total_edges <- rbind(true_edges,false_edges)
colnames(total_edges) <- c("id1","id2","obs")
n1 <- neighborhood("g'",order=1,nodes=total_edges$id1)
n1 <- neighborhood("g'",order=1,nodes=total_edges$id1)
g_prime <- delete_edges(g, links_deleted)
n1 <- neighborhood(g_prime,order=1,nodes=total_edges$id1)
n2 <- neighborhood(g_prime,order=1,nodes=total_edges$id2)
# Separate most connected into males and females
most_connected_female <- most_connected[most_connected %in% raw$`Female-id`]
most_connected_male   <- most_connected[most_connected %in% raw$`Male-id`]
# Sample one from each side
while(nrow(negative_class_links) < 5000) {
pair <- c(sample(most_connected_female, 1),
sample(most_connected_male, 1))
if(are_adjacent(g, pair[1], pair[2]) == FALSE) {
negative_class_links <- rbind(negative_class_links,
data.frame(V1 = pair[1],
V2 = pair[2]))
}
}
# Initialize columns
total_edges$sim_jacc <- 0
total_edges$sim_aa   <- 0
total_edges$sim_pref <- 0
# Compute heuristics for each node pair
for (i in 1:nrow(total_edges)) {
common <- intersection(n1[[i]], n2[[i]])
# Jaccard
total_edges$sim_jacc[i] <- length(common) /
length(union(n1[[i]], n2[[i]]))
# Adamic-Adar
if (length(common) > 0) {
total_edges$sim_aa[i] <- sum(1 / log(degree(g_prime, common)))
}
# Preferential attachment
total_edges$sim_pref[i] <- length(n1[[i]]) * length(n2[[i]])
}
