theme_set(theme_hc(base_size=16))
par(mar=c(0,0,0,0),mfrow=c(1,2))
g <- sample_gnp(100,p=0.02) # Sample Erdos Renyi of 100 nodes and 2% connection probability
cc <- components(g)
vgc <- V(g)[cc$membership==which.max(cc$csize)]
gc <- induced_subgraph(g,vgc)
plot(g,vertex.label="",vertex.color=ifelse(V(g) %in% vgc,"red","white"),vertex.size=2)
plot(gc,vertex.label="",vertex.size=2)
# Function to obtain the giant component subgraph
get_gc <- function(g){
cc <- clusters(g)
vgc <- V(g)[cc$membership==which.max(cc$csize)]
induced_subgraph(g,vgc)
}
g <- sample_gnp(1000,p=0.002)
nodes_remove <- sample(1:vcount(g)) # Random node removal
n_nodes <- vcount(g)
# Sweep values of f and check size of giant component
size_gc <- map_dfr(seq(0,1,0.05),
\(fraction){
gp <- delete_vertices(g,nodes_remove[1:(fraction*vcount(g))])
gc <- get_gc(gp)
data.frame(fraction,size=vcount(gc)/n_nodes)
}
)
k <- degree(g)
fc <- 1 - (mean(k^2)/mean(k) - 1)^(-1)
fc
size_gc %>% ggplot(aes(x=fraction,y=size)) + geom_point()+geom_vline(xintercept = fc,linetype=2) + ylab(TeX("$|LCC|$"))
nodes_remove <- order(degree(g),decreasing = T) #  highest to lowest degree
original_size <- vcount(g)
# Sweep values of f and check size of giant component
size_gc_a <- map_dfr(seq(0,1,0.05),
\(fraction){
gp <- delete.vertices(g,nodes_remove[1:(fraction*vcount(g))])
gc <- get_gc(gp)
data.frame(fraction,size=vcount(gc)/original_size)
}
)
ggplot() + geom_point(data=size_gc, aes(x=fraction,y=size,col="Random")) + geom_point(data=size_gc_a,aes(x=fraction,y=size,col="Attack"))+geom_vline(xintercept = fc,linetype=2) + ylab(TeX("$P_\\infty$"))
