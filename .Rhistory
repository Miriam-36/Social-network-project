# Libraries
library(tidyverse)
library(igraph)
library(ggthemes)
# Load Network
read <- read.csv("network_data.csv",
sep = ";",
# Skip rows in csv beginning with "#"
comment.char = "#",
header = FALSE)
# Select relevant vars and tidy
network <- read |>
# Add prefix to distinguish distinct nodes (bipartite)
mutate(female_node = paste0("f_", V1),
male_node = paste0("m_", V2)) |>
select(female_node, male_node) |>
distinct() # Drop duplicate pairs
# Create the graph
g <- graph_from_data_frame(network, directed = FALSE)
g <- simplify(g)
# Check if the network connected
is_connected(g) # FALSE
# Identify largest connected component (LCC)
components_g <- components(g)
# Create new graph extracting nodes in LCC
g <- induced_subgraph(g, which(components_g$membership == which.max(components_g$csize)))
# Assign node type as a vertex attribute
# Escorts = TRUE, Buyers = FALSE (as per igraph bipartite convention <-- CHECK THIS)
V(g)$type <- startsWith(V(g)$name, "f_")
# Check graph properties
is_bipartite(g) # TRUE
# Project onto sex buyers (type = FALSE)
g <- bipartite_projection(g, which = FALSE)
# Check number of nodes and edges after extraction
vcount(g) # Number of nodes
ecount(g) # Number of edges
# Other attributes
# Separate degree distributions
deg_escorts <- degree(g)[V(g)$type == TRUE]
deg_buyers  <- degree(g)[V(g)$type == FALSE]
data.frame(
type = c("Escorts", "Buyers"),
n = c(length(deg_escorts), length(deg_buyers)),
mean = c(mean(deg_escorts), mean(deg_buyers)),
median = c(median(deg_escorts), median(deg_buyers)),
sd = c(sd(deg_escorts), sd(deg_buyers)))
# Baseline infection times
## TODO: Replace beta = 0.05 with beta_high once Step 2 is complete
seeds_train <- sample(1:vcount(g), vcount(g) * 0.01)
realisation_train <- sim_sir(g, beta = 0.05, mu = 0.1, seeds_train)
feat_degree    <- degree(g)             |> enframe(name = "inf", value = "degree")
feat_closeness <- closeness(g)          |> enframe(name = "inf", value = "closeness")
feat_between   <- betweenness(g)        |> enframe(name = "inf", value = "betweenness")
feat_pagerank  <- page_rank(g)$vector   |> enframe(name = "inf", value = "page_rank")
## Convert inf to character so joins work correctly
feat_degree$inf    <- as.character(feat_degree$inf)
feat_closeness$inf <- as.character(feat_closeness$inf)
feat_between$inf   <- as.character(feat_between$inf)
feat_pagerank$inf  <- as.character(feat_pagerank$inf)
features <- feat_degree |>
left_join(feat_closeness, by = "inf") |>
left_join(feat_between,   by = "inf") |>
left_join(feat_pagerank,  by = "inf")
## Nodes never reached by the simulation are dropped (they have no infection time)
realization_train$inf <- as.character(realization_train$inf)
## Nodes never reached by the simulation are dropped (they have no infection time)
realisation_train$inf <- as.character(realization_train$inf)
## Nodes never reached by the simulation are dropped (they have no infection time)
realisation_train$inf <- as.character(realisation_train$inf)
training_data <- features |>
left_join(realisation_train, by = "inf") |>
filter(!is.na(t))
# model <- lm(t ~ ... , data = )
## Predicts time-to-infection (t) from network structure features
## A lower predicted t = spreads faster = better seed / more important to suppress
model <- lm(t ~ degree + closeness + betweenness + page_rank, data = training_data)
## Nodes never reached by the simulation are dropped (they have no infection time)
