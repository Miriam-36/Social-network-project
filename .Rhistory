all_degrees <- degree(g_prime)
# Initialize columns
total_edges$sim_jacc <- 0
total_edges$sim_aa   <- 0
total_edges$sim_pref <- 0
for (i in 1:nrow(total_edges)) {
common <- intersection(n1[[i]], n2[[i]])
# Jaccard
total_edges$sim_jacc[i] <- length(common) /
length(union(n1[[i]], n2[[i]]))
# Adamic-Adar — use precomputed degrees
if (length(common) > 0) {
deg_common <- all_degrees[as.character(common)]
deg_common <- deg_common[deg_common > 1]  # avoid log(1) = 0 -> Inf
if (length(deg_common) > 0) {
total_edges$sim_aa[i] <- sum(1 / log(deg_common))
}
}
# Preferential attachment
total_edges$sim_pref[i] <- length(n1[[i]]) * length(n2[[i]])
}
set.seed(123)
train_index <- sample(1:nrow(total_edges), 0.8 * nrow(total_edges))
total_edges_train <- total_edges[train_index, ]
total_edges_test  <- total_edges[-train_index, ]
total_edges_train$sim_aa[is.infinite(total_edges_train$sim_aa)] <- 0
total_edges_test$sim_aa[is.infinite(total_edges_test$sim_aa)]   <- 0
glm_link <- glm(obs ~ sim_jacc + sim_aa + sim_pref,
data   = total_edges_train,
family = binomial(link = 'logit'))
glm_prediction <- predict.glm(glm_link,
newdata = total_edges_test,
type = "response")
library(caret)
pred <- sign(glm_prediction > 0.3)
confusionMatrix(factor(pred),factor(total_edges_test$obs),positive = "1")
summary(glm_link)
nrow(total_edges_test)
table(total_edges_test$obs)
length(glm_prediction)
length(total_edges_test$obs)
sum(is.na(glm_prediction))
summary(total_edges_test)
sum(is.na(total_edges_test$sim_jacc))
sum(is.na(total_edges_test$sim_aa))
sum(is.na(total_edges_test$sim_pref))
sum(is.infinite(total_edges_test$sim_aa))
summary(total_edges_test)
sum(is.na(total_edges_test$sim_jacc))
sum(is.na(total_edges_test$sim_aa))
sum(is.na(total_edges_test$sim_pref))
sum(is.infinite(total_edges_test$sim_aa))
total_edges_test$sim_aa[is.na(total_edges_test$sim_aa)] <- 0
total_edges_train$sim_aa[is.na(total_edges_train$sim_aa)] <- 0
# Refit the model with clean training data
glm_link <- glm(obs ~ sim_jacc + sim_aa + sim_pref,
data   = total_edges_train,
family = binomial(link = 'logit'))
# Re-predict
glm_prediction <- predict.glm(glm_link,
newdata = total_edges_test,
type    = "response")
# Confirm no NAs
sum(is.na(glm_prediction))
library(caret)
pred <- sign(glm_prediction > 0.3)
confusionMatrix(factor(pred),factor(total_edges_test$obs),positive = "1")
summary(glm_link)
