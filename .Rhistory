library(tidyverse)
library(igraph)
library(igraphdata)
library(jsonlite)
library(visNetwork)
library(widgetframe)
library(ggthemes)
library(readr)
raw_data <- read_delim(
file       = "brazilian_prostitution.csv",
delim      = ";",
comment    = "#",
col_names  = FALSE,
trim_ws    = TRUE,
col_types  = cols(.default = col_integer())
) |>
rename(
`sex_worker-id`                                                                   = X1,
`sex_buyer-id`                                                                    = X2,
`Date (in days) of posting`                                                       = X3,
`Grade`                                                                           = X4,
`Anal sex with/without condom?`                                                   = X5,
`Oral sex with condom?`                                                           = X6,
`Mouth kiss?`                                                                     = X7)
raw_data
g <- graph_from_data_frame(raw_data, directed=FALSE) |> simplify()
vcount(g)
ecount(g)
degree(g) |>
mean()
assortativity_degree(g)
# Identify each type of node
sex_workers <- as.character(unique(raw_data$`sex_worker-id`))
sex_buyers  <- as.character(unique(raw_data$`sex_buyer-id`))
# For each sex buyer, calculate the average degree of the sex workers they connect to
buyer_avg <- sapply(sex_buyers, function(b) {
partners <- neighbors(g, b)              # sex workers connected to this buyer
mean(degree(g, partners))                # average degree of those workers
})
# For each sex worker, calculate the average degree of the sex buyers they connect to
worker_avg <- sapply(sex_workers, function(w) {
partners <- neighbors(g, w)              # sex buyers connected to this worker
mean(degree(g, partners))                # average degree of those buyers
})
# Compare the averages
mean(buyer_avg)    # average degree of workers that buyers connect to
mean(worker_avg)   # average degree of buyers that workers connect to
ggplot() +
geom_histogram(aes(x = degree(g)), bins = 10) +
scale_x_continuous(n.breaks = 20)
knitr::include_graphics("G.png")
V(g)$type <- V(g)$name %in% as.character(unique(raw_data$`sex_worker-id`))
# Project onto sex buyers (type = FALSE)
g <- bipartite_projection(g, which = FALSE)
vcount(g)
ecount(g)
degree(g) |>
mean()
set.seed(111)
links_deleted <- sample(1:ecount(g), 5000)
positive_class_links <- as.data.frame(ends(g, links_deleted))
positive_class_links
negative_class_links <- data.frame()
g_prime <- delete_edges(g, links_deleted)
quantile(degree(g), 0.75)
most_connected <- V(g)$name[degree(g) > 150]
negative_class_links <- data.frame(V1 = integer(), V2 = integer())
while(nrow(negative_class_links) < 5000) {
pair <- sample(most_connected, 2)
if(are_adjacent(g, pair[1], pair[2]) == FALSE) {
negative_class_links <- rbind(negative_class_links,
data.frame(V1 = pair[1],
V2 = pair[2]))
}
}
true_edges <- data.frame(positive_class_links, obs = 1)
false_edges <- data.frame(negative_class_links, obs = 0)
total_edges <- rbind(true_edges,false_edges)
colnames(total_edges) <- c("id1","id2","obs")
total_edges$id1 <- as.character(total_edges$id1)
total_edges$id2 <- as.character(total_edges$id2)
n1 <- neighborhood(g_prime,order=1,nodes=total_edges$id1)
n2 <- neighborhood(g_prime,order=1,nodes=total_edges$id2)
# Precompute degree for all nodes
all_degrees <- degree(g_prime)
# Initialize columns
total_edges$sim_jacc <- 0
total_edges$sim_aa   <- 0
total_edges$sim_pref <- 0
for (i in 1:nrow(total_edges)) {
common <- intersection(n1[[i]], n2[[i]])
# Jaccard
total_edges$sim_jacc[i] <- length(common) /
length(union(n1[[i]], n2[[i]]))
# Adamic-Adar — use precomputed degrees
if (length(common) > 0) {
deg_common <- all_degrees[as.character(common)]
deg_common <- deg_common[deg_common > 1]  # avoid log(1) = 0 -> Inf
if (length(deg_common) > 0) {
total_edges$sim_aa[i] <- sum(1 / log(deg_common))
}
}
# Preferential attachment
total_edges$sim_pref[i] <- length(n1[[i]]) * length(n2[[i]])
}
set.seed(123)
train_index <- sample(1:nrow(total_edges), 0.8 * nrow(total_edges))
total_edges_train <- total_edges[train_index, ]
total_edges_test  <- total_edges[-train_index, ]
total_edges_train$sim_aa[is.infinite(total_edges_train$sim_aa)] <- 0
total_edges_test$sim_aa[is.infinite(total_edges_test$sim_aa)]   <- 0
glm_link <- glm(obs ~ sim_jacc + sim_aa + sim_pref,
data   = total_edges_train,
family = binomial(link = 'logit'))
glm_prediction <- predict.glm(glm_link,
newdata = total_edges_test,
type = "response")
library(caret)
pred <- sign(glm_prediction > 0.3)
confusionMatrix(factor(pred),factor(total_edges_test$obs),positive = "1")
summary(glm_link)
nrow(total_edges_test)
table(total_edges_test$obs)
length(glm_prediction)
length(total_edges_test$obs)
sum(is.na(glm_prediction))
summary(total_edges_test)
sum(is.na(total_edges_test$sim_jacc))
sum(is.na(total_edges_test$sim_aa))
sum(is.na(total_edges_test$sim_pref))
sum(is.infinite(total_edges_test$sim_aa))
summary(total_edges_test)
sum(is.na(total_edges_test$sim_jacc))
sum(is.na(total_edges_test$sim_aa))
sum(is.na(total_edges_test$sim_pref))
sum(is.infinite(total_edges_test$sim_aa))
total_edges_test$sim_aa[is.na(total_edges_test$sim_aa)] <- 0
total_edges_train$sim_aa[is.na(total_edges_train$sim_aa)] <- 0
# Refit the model with clean training data
glm_link <- glm(obs ~ sim_jacc + sim_aa + sim_pref,
data   = total_edges_train,
family = binomial(link = 'logit'))
# Re-predict
glm_prediction <- predict.glm(glm_link,
newdata = total_edges_test,
type    = "response")
# Confirm no NAs
sum(is.na(glm_prediction))
library(caret)
pred <- sign(glm_prediction > 0.3)
confusionMatrix(factor(pred),factor(total_edges_test$obs),positive = "1")
summary(glm_link)
library(tidyverse)
library(igraph)
library(igraphdata)
library(jsonlite)
library(visNetwork)
library(widgetframe)
library(ggthemes)
library(readr)
